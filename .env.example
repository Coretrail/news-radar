# Generate .env and a random database password: node scripts/init-env.mjs
# This file contains examples only. Never commit .env or share bootstrap URLs.
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Lisbon
HOST=127.0.0.1
PORT=3001

# Native: Unix socket + peer authentication. Compose overrides host/user for its DB.
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=newsradar
PGUSER=newsradar
PGPASSWORD=
# Compose database administrator password; not passed to application services.
PGADMIN_PASSWORD=
# Optional alternative for native deployments (avoid sharing URLs with credentials).
DATABASE_URL=
# Explicit proxy IPs/CIDRs, comma separated; false means no trusted proxy.
TRUST_PROXY=127.0.0.1,::1

# Compose publishes only to this host address. Choose a LAN address deliberately.
COMPOSE_PROJECT_NAME=news-radar
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Change both values if this private Docker subnet conflicts with your environment.
COMPOSE_SUBNET=172.30.240.0/24
PROXY_ADDRESS=172.30.240.10
# Proxy checks original client IP. Space-separated IPs/CIDRs; "all" is opt-in.
# Default all relies on the loopback-only HTTP_BIND. Set explicit CIDRs before LAN exposure.
# Docker NAT may change client IP. Check the observed source before setting a LAN ACL.
ALLOWED_NETWORKS=all

LOCAL_CATEGORY_ID=local
LOCAL_REGION_NAME="Notícias locais"
LOCAL_REGION_KEYWORDS=
# minimal: BBC + Hacker News; all: optional disabled catalog too; none: no sources.
SEED_SOURCES=minimal

# Translation into PT-PT is optional; app/collector work without models or Python.
TRANSLATION_ENABLED=false
TRANSLATION_PYTHON=.venv-translation/bin/python
TRANSLATION_MODELS=./models
# Enable Compose worker only after model provisioning and license review:
COMPOSE_PROFILES=

# Used only by the native template renderer; absolute paths required.
NATIVE_INSTALL_DIR=/srv/news-radar
NATIVE_USER=newsradar
NATIVE_GROUP=newsradar
NODE_BINARY=/usr/bin/node
NATIVE_SERVER_NAME=localhost
NATIVE_LISTEN=127.0.0.1:8080

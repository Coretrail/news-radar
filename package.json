{
  "name": "news-radar",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json && node scripts/copy-runtime.mjs",
    "test": "NODE_ENV=test tsx --test tests/domain.test.ts tests/security.test.ts tests/jetstream.test.ts tests/translation.test.ts tests/config.test.ts tests/packaging.test.mjs",
    "test:integration": "NODE_ENV=test tsx --test tests/integration.test.ts",
    "migrate": "tsx server/migrate.ts",
    "seed": "tsx server/seed.ts",
    "collector": "tsx server/collector.ts",
    "api": "tsx server/main.ts",
    "admin:setup": "tsx server/admin-cli.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:live": "tsx tests/live-pipeline.ts",
    "test:admin": "tsx tests/admin-browser.ts && tsx tests/admin-navigation.ts",
    "test:reconnect": "tsx tests/reconnect-browser.ts",
    "test:translation": "NODE_ENV=test tsx --test tests/translation-integration.test.ts",
    "test:translation:browser": "tsx tests/translation-browser.ts",
    "translation": "tsx server/translation-worker.ts",
    "start": "node build/main.js",
    "check": "tsc --noEmit",
    "init:env": "node scripts/init-env.mjs",
    "test:access": "NODE_ENV=test tsx tests/access-page.ts",
    "test:screenshots": "tsx scripts/screenshots.ts",
    "test:bootstrap": "tsx tests/bootstrap-browser.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fontsource/inter": "^5.2.0",
    "fastify": "^5.0.0",
    "franc-min": "^6.2.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.56.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "description": "Self-hosted live news monitoring dashboard with RSS, Hacker News and Bluesky collectors",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true
}
